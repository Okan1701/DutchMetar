{
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/DutchMetar",
  "shutdownAction": "stopCompose",
  "features": {},
  "postCreateCommand": "dotnet dev-certs https && . \"$NVM_DIR/nvm.sh\" && nvm install --lts",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-mssql.mssql",
        "Angular.ng-template"
      ]
    }
  }
}
