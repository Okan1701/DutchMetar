{
  "name": "dutchmetar.web.client",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "run-script-os",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prestart": "node aspnetcore-https",
    "start:windows": "ng serve --ssl --ssl-cert \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.pem\" --ssl-key \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.key\" --host=127.0.0.1",
    "start:default": "ng serve --ssl --ssl-cert \"$HOME/.aspnet/https/${npm_package_name}.pem\" --ssl-key \"$HOME/.aspnet/https/${npm_package_name}.key\" --host=127.0.0.1"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "apexcharts": "^5.16.0",
    "jest-editor-support": "^31.1.2",
    "ng-apexcharts": "^2.5.0",
    "run-script-os": "^1.1.6",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
